# A3 reads environment variables; it does not automatically load this file.
DATABASE_URL=sqlite:///./data/runtime/platform.db
ARTIFACT_ROOT=./artifacts
# Generate two separate secrets with secrets.token_urlsafe(48); never commit them.
APP_ADMIN_TOKEN=
APP_SCORER_TOKEN=
INFERENCE_TIMEOUT_MS=2000
# UI server uses this fixed trusted backend. No automatic .env loading.
API_BASE_URL=http://127.0.0.1:8000
